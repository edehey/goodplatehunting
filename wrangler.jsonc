{
  "name": "goodplatehunting",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 10 * * *"] },
  "send_email": [{ "name": "MAIL" }],
  "kv_namespaces": [
    { "binding": "GROUPS" }
  ]
}
